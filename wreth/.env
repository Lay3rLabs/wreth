# WRETH Local Development Environment Variables
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# Logging configuration
RUST_LOG=info,wavs=debug,reth=info

# WAVS submission mnemonic (test mnemonic for local development only)
# WARNING: Do not use this mnemonic for any real funds!
WAVS_SUBMISSION_MNEMONIC="test test test test test test test test test test test junk"

# Optional: Override WAVS port
# WAVS_PORT=8000

# Optional: Override aggregator port
# WAVS_AGGREGATOR_PORT=8001
